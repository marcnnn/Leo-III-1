thf(exuE3e_def, definition, exuE3e = (! [A:($i > $o)]: ((exu @ (A)) => (? [B:$i]: (A @ B)))) ).
thf(setext_def, definition, setext = (! [A:$i,B:$i]: ((! [C:$i]: ((in @ C @ A) => (in @ C @ B))) => ((! [C:$i]: ((in @ C @ B) => (in @ C @ A))) => (A = B)))) ).
