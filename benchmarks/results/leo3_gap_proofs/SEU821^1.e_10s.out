thf(exu_def, definition, exu = (^ [A:($i > $o)]: ? [B:$i]: ((A @ B) & ! [C:$i]: ((A @ C) => (B = C)))) ).
thf(setextAx_def, definition, setextAx = (! [A:$i,B:$i]: ((! [C:$i]: ((in @ C @ A) = (in @ C @ B))) => (A = B))) ).
thf(emptysetAx_def, definition, emptysetAx = (! [A:$i]: ~ (in @ A @ emptyset)) ).
thf(setadjoinAx_def, definition, setadjoinAx = (! [A:$i,B:$i,C:$i]: ((in @ C @ (setadjoin @ A @ B)) = ((C = A) | (in @ C @ B)))) ).
thf(powersetAx_def, definition, powersetAx = (! [A:$i,B:$i]: ((in @ B @ (powerset @ A)) = (! [C:$i]: ((in @ C @ B) => (in @ C @ A))))) ).
thf(setunionAx_def, definition, setunionAx = (! [A:$i,B:$i]: ((in @ B @ (setunion @ A)) = (? [C:$i]: ((in @ B @ C) & (in @ C @ A))))) ).
thf(omega0Ax_def, definition, omega0Ax = (in @ emptyset @ omega) ).
thf(omegaSAx_def, definition, omegaSAx = (! [A:$i]: ((in @ A @ omega) => (in @ (setadjoin @ A @ A) @ omega))) ).
thf(omegaIndAx_def, definition, omegaIndAx = (! [A:$i]: (((in @ emptyset @ A) & ! [B:$i]: (((in @ B @ omega) & (in @ B @ A)) => (in @ (setadjoin @ B @ B) @ A))) => (! [B:$i]: ((in @ B @ omega) => (in @ B @ A))))) ).
thf(replAx_def, definition, replAx = (! [A:($i > ($i > $o)),B:$i]: ((! [C:$i]: ((in @ C @ B) => (exu @ (A @ C)))) => (? [C:$i]: ! [D:$i]: ((in @ D @ C) = (? [E:$i]: ((in @ E @ B) & (A @ E @ D))))))) ).
thf(foundationAx_def, definition, foundationAx = (! [A:$i]: ((? [B:$i]: (in @ B @ A)) => (? [B:$i]: ((in @ B @ A) & ~ (? [C:$i]: ((in @ C @ B) & (in @ C @ A))))))) ).
thf(wellorderingAx_def, definition, wellorderingAx = (! [A:$i]: ? [B:$i]: (! [C:$i]: ((in @ C @ B) => (! [D:$i]: ((in @ D @ C) => (in @ D @ A)))) & ! [C:$i,D:$i]: (((in @ C @ A) & (in @ D @ A)) => ((! [E:$i]: ((in @ E @ B) => ((in @ C @ E) = (in @ D @ E)))) => (C = D))) & ! [C:$i,D:$i]: (((in @ C @ B) & (in @ D @ B)) => (! [E:$i]: ((in @ E @ C) => (in @ E @ D)) | ! [E:$i]: ((in @ E @ D) => (in @ E @ C)))) & ! [C:$i]: ((! [D:$i]: ((in @ D @ C) => (in @ D @ A)) & ? [D:$i]: (in @ D @ C)) => (? [D:$i,E:$i]: ((in @ D @ B) & (in @ E @ C) & ~ (? [F:$i]: ((in @ F @ D) & (in @ F @ C))) & ! [F:$i]: ((in @ F @ B) => (! [G:$i]: ((in @ G @ F) => (in @ G @ D)) | (in @ E @ F)))))))) ).
thf(descrp_def, definition, descrp = (! [A:($i > $o)]: ((exu @ (A)) => (A @ (descr @ (A))))) ).
thf(dsetconstrI_def, definition, dsetconstrI = (! [A:$i,B:($i > $o),C:$i]: ((in @ C @ A) => ((B @ C) => (in @ C @ (dsetconstr @ A @ (B)))))) ).
thf(dsetconstrEL_def, definition, dsetconstrEL = (! [A:$i,B:($i > $o),C:$i]: ((in @ C @ (dsetconstr @ A @ (B))) => (in @ C @ A))) ).
thf(dsetconstrER_def, definition, dsetconstrER = (! [A:$i,B:($i > $o),C:$i]: ((in @ C @ (dsetconstr @ A @ (B))) => (B @ C))) ).
