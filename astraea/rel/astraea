#!/bin/sh
# Leo-III compatible command line of the Astraea release: `astraea problem.p -t 60 -p`.
# Boots the release in `eval` mode (no application start-up beyond Astraea's own)
# and runs `Astraea.CLI.main/1` on the arguments.
set -e
SELF=$(readlink "$0" || true)
if [ -z "$SELF" ]; then SELF="$0"; fi
BIN_DIR=$(cd "$(dirname "$SELF")" && pwd -P)
exec "$BIN_DIR/astraea_release" eval "Astraea.CLI.main(System.argv())" "$@"
